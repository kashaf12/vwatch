{
  "name": "vwatch",
  "description": "Watch local video files like a person: MCP tools for timestamped frame grids, dense seeks, crops, transcript, loudness and model-free signal hints, plus the watch-video skill. The tools make no model calls and need no API key.",
  "version": "0.2.0",
  "author": {
    "name": "kashaf12",
    "url": "https://github.com/kashaf12"
  },
  "homepage": "https://github.com/kashaf12/vwatch",
  "repository": "https://github.com/kashaf12/vwatch",
  "license": "MIT",
  "keywords": ["video", "mcp", "multimodal", "ffmpeg", "whisper", "qa", "perception"],
  "network": {
    "hosts": ["github.com", "pypi.org", "files.pythonhosted.org", "huggingface.co"]
  },
  "mcpServers": {
    "vwatch": {
      "command": "uvx",
      "args": ["--from", "vwatch[mcp] @ git+https://github.com/kashaf12/vwatch@v0.2.0", "vwatch-mcp"]
    }
  }
}
